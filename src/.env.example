# Copy this file to .env and fill in your actual values
# NEVER commit the .env file — it is in .gitignore

# IBM Bob deployment endpoint used by bob_interface.py to send BLUF reports
# for conversational commander follow-up (e.g. https://bob.internal.ibm.com/v1/chat)
BOB_ENDPOINT=

# API key/token for the Bob endpoint above
BOB_API_KEY=

# Optional: directory of live feed files, if different from sample_data/
FEED_DATA_DIR=sample_data