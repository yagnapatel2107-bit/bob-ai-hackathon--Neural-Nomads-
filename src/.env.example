# Copy this file to .env and fill in your actual values
# NEVER commit the .env file — it is in .gitignore

# IBM watsonx.ai — used by watsonx_client.py / mcp_server.py's
# summarize_for_commander tool to generate executive summaries
WATSONX_API_KEY=your_api_key_here
WATSONX_PROJECT_ID=your_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# IBM Bob deployment endpoint used by bob_interface.py to send BLUF reports
# for conversational commander follow-up (e.g. https://bob.internal.ibm.com/v1/chat)
BOB_ENDPOINT=
BOB_API_KEY=

# Optional: directory of live feed files, if different from sample_data/
FEED_DATA_DIR=sample_data
